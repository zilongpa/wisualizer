[gd_scene format=3]

[ext_resource type="Script" path="res://app/launcher.gd" id="1"]
[ext_resource type="Texture2D" path="res://branding/icon.png" id="2"]
[ext_resource type="Texture2D" path="res://app/icons/delete.svg" id="3"]
[ext_resource type="Texture2D" path="res://app/icons/edit.svg" id="4"]
[ext_resource type="Texture2D" path="res://app/icons/settings.svg" id="5"]
[ext_resource type="PackedScene" path="res://app/settings_window.tscn" id="6"]

[sub_resource type="StyleBoxFlat" id="LogoShape"]
corner_radius_top_left = 36
corner_radius_top_right = 36
corner_radius_bottom_right = 36
corner_radius_bottom_left = 36
corner_detail = 16
anti_aliasing_size = 0.5

[node name="Launcher" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24
script = ExtResource("1")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LogoMask" type="Panel" parent="Column"]
clip_children = 1
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_horizontal = 4
theme_override_styles/panel = SubResource("LogoShape")

[node name="Logo" type="TextureRect" parent="Column/LogoMask"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Wisualizer"
horizontal_alignment = 1

[node name="Version" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Version"
horizontal_alignment = 1

[node name="Open" type="Button" parent="Column"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
tooltip_text = "Open a ZIP, and add it to the library if you like"
size_flags_horizontal = 4
text = "Open…"

[node name="New" type="Button" parent="Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
tooltip_text = "Make a ZIP: import GLBs, bricks and images, and write the notes"
text = "New…"

[node name="Separator" type="HSeparator" parent="Column"]
layout_mode = 2

[node name="LibraryTitle" type="Label" parent="Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Library"

[node name="Empty" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Open a ZIP to start, and add it to the library to open it again later."
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Library" type="VBoxContainer" parent="Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Row" type="HBoxContainer" parent="Column/Scroll/Library"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="Open" type="Button" parent="Column/Scroll/Library/Row"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ListRow"
text = "ZIP"
alignment = 0
text_overrun_behavior = 3

[node name="Edit" type="Button" parent="Column/Scroll/Library/Row"]
theme_type_variation = &"IconButton"
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Edit in a workspace"
icon = ExtResource("4")
icon_alignment = 1
expand_icon = true

[node name="Delete" type="Button" parent="Column/Scroll/Library/Row"]
theme_type_variation = &"IconButton"
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Delete from the library"
icon = ExtResource("3")
icon_alignment = 1
expand_icon = true

[node name="Settings" type="Button" parent="Column"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
tooltip_text = "The debug view, and how the field sounds"
theme_override_constants/icon_max_width = 20
text = "Settings"
icon = ExtResource("5")

[node name="SettingsWindow" parent="." instance=ExtResource("6")]
unique_name_in_owner = true

[node name="Files" type="FileDialog" parent="."]
title = "Open a File"
file_mode = 0
access = 2
filters = PackedStringArray("*.zip ; ZIP")
use_native_dialog = true

[node name="ConfirmAdd" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
size = Vector2i(880, 200)
dialog_autowrap = true
ok_button_text = "Add to Library"

[node name="ConfirmNew" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "New ZIP"
size = Vector2i(720, 200)
ok_button_text = "Create"

[node name="NewName" type="LineEdit" parent="ConfirmNew"]
unique_name_in_owner = true
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = 48.0
anchors_preset = 10
anchor_right = 1.0
placeholder_text = "Name"

[node name="ConfirmDelete" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
size = Vector2i(880, 200)
dialog_autowrap = true
title = "Delete from the library?"
ok_button_text = "Delete"

[connection signal="pressed" from="Column/Open" to="Files" method="popup_centered"]
[connection signal="file_selected" from="Files" to="." method="pick_zip"]
[connection signal="confirmed" from="ConfirmAdd" to="." method="_on_add_answered" binds= [0]]
[connection signal="custom_action" from="ConfirmAdd" to="." method="_on_add_custom"]
[connection signal="pressed" from="Column/New" to="." method="ask_new"]
[connection signal="confirmed" from="ConfirmNew" to="." method="create_new"]
[connection signal="text_submitted" from="ConfirmNew/NewName" to="." method="create_new" unbinds=1]
[connection signal="confirmed" from="ConfirmDelete" to="." method="delete_pending"]
[connection signal="pressed" from="Column/Settings" to="SettingsWindow" method="show"]
