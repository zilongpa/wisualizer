[connection signal="close_requested" from="Model" to="." method="close"]
[connection signal="input_event" from="Model/Turntable/Grab" to="." method="turn_by_drag"]
[connection signal="resized" from="Model/Volume" to="." method="fit" unbinds=1]
[connection signal="pressed" from="Model/Controls/Bar/Play" to="." method="toggle_play"]
[connection signal="value_changed" from="Model/Controls/Bar/Frame" to="." method="seek"]
[connection signal="toggled" from="Model/Options/Bar/ShowLabels" to="Model/Turntable/Labels" method="set_visible"]
[connection signal="toggled" from="Model/Controls/Bar/NotesButton" to="." method="show_notes"]
[connection signal="close_requested" from="Model/Notes" to="." method="close_notes"]
[connection signal="meta_clicked" from="Model/Notes/Margin/Text" to="." method="open_link"]
[connection signal="toggled" from="Model/Controls/Bar/OptionsButton" to="." method="show_options"]
[connection signal="toggled" from="Model/Controls/Bar/ProbesButton" to="." method="show_probes"]
[connection signal="close_requested" from="Model/Probes" to="." method="close_probes"]
[connection signal="toggled" from="Model/Controls/Bar/ImmersiveButton" to="Model/Volume" method="set_immersive" flags=1]
[connection signal="immersive_changed" from="Model/Volume" to="." method="_on_immersive_changed"]
