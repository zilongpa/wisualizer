custom_minimum_size = Vector2(36, 36)
layout_mode = 2
tooltip_text = "Remove the selected image"
theme_type_variation = &"IconButton"
icon = ExtResource("2")
icon_alignment = 1
expand_icon = true

[node name="ImageList" type="ItemList" parent="Root/Content/Pages/Images/Row/ListCard/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="InsertImage" type="Button" parent="Root/Content/Pages/Images/Row/ListCard/Column"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
tooltip_text = "Add an [img] tag for it at the notes' cursor"
text = "Insert into notes"

[node name="PreviewCard" type="PanelContainer" parent="Root/Content/Pages/Images/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Card"

[node name="ImagePreview" type="TextureRect" parent="Root/Content/Pages/Images/Row/PreviewCard"]
unique_name_in_owner = true
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Notes" type="VBoxContainer" parent="Root/Content/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Root/Content/Pages/Notes"]
layout_mode = 2
theme_type_variation = &"Header"
text = "Notes"

[node name="Caption" type="Label" parent="Root/Content/Pages/Notes"]
layout_mode = 2
theme_type_variation = &"Caption"
text = "Godot BBCode on the left, as it will look beside the volume on the right: [b]bold[/b], [img]images/flow.png[/img], and [url=frame:9]frame 9[/url], which pauses the first model on frame 9."
autowrap_mode = 3

[node name="Gap" type="Control" parent="Root/Content/Pages/Notes"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="Split" type="HSplitContainer" parent="Root/Content/Pages/Notes"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Editor" type="CodeEdit" parent="Root/Content/Pages/Notes/Split"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
placeholder_text = "Write the notes here."
wrap_mode = 1
scroll_fit_content_width = true

[node name="PreviewCard" type="PanelContainer" parent="Root/Content/Pages/Notes/Split"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Card"

[node name="NotesPreview" type="RichTextLabel" parent="Root/Content/Pages/Notes/Split/PreviewCard"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true

[node name="GLBFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import GLBs"
file_mode = 1
access = 2
filters = PackedStringArray("*.glb ; GLB")
use_native_dialog = true

[node name="BOVFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import Brick Headers"
file_mode = 1
access = 2
use_native_dialog = true

[node name="ImageFiles" type="FileDialog" parent="."]
