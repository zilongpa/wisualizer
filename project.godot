; Minimal device test for GodotRealityKit hand tracking in an immersive space.

config_version=5

[application]

config/name="Hand Test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_loop_type.visionos="RealitySceneTree"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotRealityKit/plugin.cfg")

[reality_kit]

presentation_style="Immersive"
immersion_style="Mixed"

[xr]

visionos/enable_hand_tracking=true
